{
  "default_stop_words": [
    "defmodule",
    "defrecord",
    "defimpl",
    "defexception",
    "defprotocol",
    "defstruct",
    "def.+(.+\\\\.+).+do",
    "^\\s+use\\s+"
  ],
  "coverage_options": {
    "treat_no_relevant_lines_as_covered": true,
    "html_filter_full_covered": true,
    "minimum_coverage": 100
  },
  "skip_files": [
    "lib/rail/application.ex",
    "lib/rail_web/endpoint.ex",
    "lib/rail_web/router.ex",
    "lib/rail_web/gettext.ex",
    "lib/mix",
    "test/"
  ]
}
