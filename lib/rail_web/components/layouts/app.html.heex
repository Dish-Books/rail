<div class="flex h-screen w-screen overflow-hidden bg-[var(--color-surface)]" id="app-scaffold">
  <.nav_rail
    current_section={assigns[:current_section] || :overview}
    is_rail_extended={assigns[:is_rail_extended] != false}
    attention_count={assigns[:attention_count] || 0}
    current_project_id={assigns[:current_project_id]}
  />

  <div class="flex flex-col flex-1 min-w-0 h-full overflow-hidden">
    <.top_app_bar
      current_section={assigns[:current_section] || :overview}
      current_project_id={assigns[:current_project_id]}
      projects={assigns[:projects] || []}
      theme={assigns[:theme] || "dark"}
      show_project_switcher={assigns[:show_project_switcher] == true}
      show_new_issue_modal={assigns[:show_new_issue_modal] == true}
    />

    <main class="flex-1 overflow-y-auto p-6" id="main-content">
      {@inner_content}
    </main>
  </div>
</div>
